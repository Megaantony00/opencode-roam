{
  "name": "opencode-roam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted web/PWA remote for OpenCode, with optional Telegram notifications and approvals.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megaantony00/opencode-roam.git"
  },
  "homepage": "https://github.com/Megaantony00/opencode-roam#readme",
  "bugs": {
